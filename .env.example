# =============================================================================
# VFS Alert - Environment Variables Template
# =============================================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your actual credentials below.
# 3. NEVER commit the .env file to Git — it is already in .gitignore.
# =============================================================================

# --- IPRoyal Residential Proxy ---
PROXY_HOST=geo.iproyal.com
PROXY_PORT=12321
PROXY_USER=your_proxy_username
PROXY_PASS=your_proxy_password

# --- Anti-Captcha API ---
ANTICAPTCHA_KEY=your_anticaptcha_api_key
